[Desktop Entry]
Type=Application
Name=PhotoCraft
GenericName=Image Editor
Comment=Edit photos and layered PSD documents
Exec=photocraft %F
TryExec=photocraft
Icon=ai.storyteller.photocraft
Terminal=false
StartupNotify=true
StartupWMClass=photocraft
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
Keywords=photo;image;editor;psd;photoshop;layers;retouch;paint;
MimeType=application/x-photocraft;image/vnd.adobe.photoshop;image/x-psd;image/x-psb;image/png;image/jpeg;image/tiff;image/webp;image/gif;image/bmp;image/x-tga;image/x-icon;image/vnd.microsoft.icon;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-exr;image/vnd.radiance;image/avif;image/qoi;
